@page
@model EntityEditor.Pages.Clients.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Client</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Client.IndividualTaxNumber" class="control-label"></label>
                <input asp-for="Client.IndividualTaxNumber" class="form-control" />
                <span asp-validation-for="Client.IndividualTaxNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Client.Name" class="control-label"></label>
                <input asp-for="Client.Name" class="form-control" />
                <span asp-validation-for="Client.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Client.OrganizationType" class="control-label"></label>
                <select asp-for="Client.OrganizationType" class="form-control">
                    <option value="">Choose an organization type</option>
                    <option value="EN">Company</option>
                    <option value="IE">Individual entrepreneur</option>
                </select>
                <span asp-validation-for="Client.OrganizationType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>
