<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Entity Editor</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="container navigation" aria-label="Main navigation">
            <a class="brand" asp-page="/Index">Entity Editor</a>
            <a asp-page="/Index">Home</a>
            <a asp-page="/Clients/Index">Clients</a>
        </nav>
    </header>
    <main class="container" id="main">
        @RenderBody()
    </main>
    <footer class="container">
        Entity Editor &middot; A C# CRUD demonstration
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>